generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email String @unique
  isTemporaryEmail Boolean @default(false)
  firstName String
  lastName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passwordHash  String
}
